# ====================================================================
# SynapseSQL Enterprise Environment Configuration (.env)
# Copy this file to .env:  cp .env.example .env
# ====================================================================

# [Required] Groq API Key (Free tier available at https://console.groq.com)
# Used for high-speed AI SQL generation (Llama 3 / Qwen / Mixtral)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# [Optional] OpenAI API Key (https://platform.openai.com)
OPENAI_API_KEY="sk-proj-your_openai_key_here"

# [Optional] Hugging Face Token (https://huggingface.co/settings/tokens)
HF_TOKEN="hf_your_huggingface_token_here"

# [Optional] LangSmith Observability & Tracing (https://smith.langchain.com)
LANGCHAIN_API_KEY="lsv2_pt_your_langchain_api_key_here"
LANGCHAIN_PROJECT="SynapseSQL-Enterprise"
LANGCHAIN_TRACING_V2="false"

# [Optional] Google OAuth 2.0 Client ID (https://console.cloud.google.com/apis/credentials)
# Note: In Google Cloud Console, register http://localhost:8000 under Authorized JavaScript Origins
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# [Required] JWT Secret Key for Session & RBAC signing
# Generate a fresh value - there is NO default and the server refuses to start
# without one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=""

# [Optional] Supabase Authentication & PostgreSQL Usage Ingestion
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_your_anon_key"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_your_service_role_key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_your_anon_key"

